# --- Application Security ---
SECRET_KEY=your_secret_local_development_key_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database (MySQL 8) ---
# Coincide con el servicio "mysql" de docker-compose.yml
DATABASE_URL=mysql+pymysql://simapci:simapci@localhost:3306/simapci
DATABASE_ECHO=false

# --- External integrations (Crossref, OpenAlex, ORCID) ---
# Correo para el "polite pool" de Crossref y OpenAlex (recomendado)
INTEGRATIONS_CONTACT_EMAIL=
INTEGRATIONS_TIMEOUT_SECONDS=5

# --- LDAP Configuration ---
LDAP_SERVER_URI=ldap://localhost:10389

# Service Account credentials for directory searches
LDAP_BIND_DN=cn=admin,dc=planetexpress,dc=com
LDAP_BIND_PASSWORD=GoodNewsEveryone

# Directory base DNs
LDAP_USER_BASE_DN=ou=people,dc=planetexpress,dc=com
LDAP_GROUP_BASE_DN=ou=people,dc=planetexpress,dc=com

# Group name or identifier for authorization check
LDAP_PROFESSOR_GROUP_CN=admin_staff

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
