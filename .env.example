# Copy this file to .env and fill it in. Never commit the real .env.

# --- Application ---------------------------------------------------------
APP_NAME=RED PAPERS API
API_VERSION=1.0.0
DEBUG=False

# --- Database credentials (MySQL/MariaDB or PostgreSQL) ------------------
DB_USER=apiuser
DB_PASSWORD=change-this
DB_HOST=localhost
DB_PORT=3306
DB_NAME=red_papers

# Optional. When set it overrides every DB_* value above. Useful to run the
# API on SQLite without a database server, e.g. sqlite:///./red_papers.db
# For PostgreSQL use: postgresql+psycopg2://user:password@host:5432/dbname
# DATABASE_URL=

# --- JSON Web Tokens -----------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-this-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- ORCID (academic identity provider) -----------------------------------
# Register a sandbox app at https://sandbox.orcid.org/developer-tools
# Redirect URI to register there: http://127.0.0.1:8000/orcid/callback
ORCID_ENVIRONMENT=sandbox
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# --- Bibliometric pipeline (Crossref / OpenAlex) --------------------------
# Supplying a contact email grants both APIs' faster "polite pool".
CROSSREF_CONTACT_EMAIL=
OPENALEX_CONTACT_EMAIL=

# --- Governance ------------------------------------------------------------
# Comma separated emails promoted to the ADMIN (review committee) role the
# moment they register. Everyone else registers as a PROFESSOR.
ADMIN_BOOTSTRAP_EMAILS=jastudillo@yachaytech.edu.ec

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=*
